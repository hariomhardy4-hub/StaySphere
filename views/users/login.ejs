<% layout("/layouts/boilerplate")%>

<div class = "row mt-3"><!-- form hum chahte hai ki ye adjoin wale row ke andr create ho -->
   <h2 class = "col-6 offset-3"> Login on StaySphere</h2>
    <br><br><br>
   <div class = "col-6 offset-3">
    <form action = "/login" method = "POST" class = "needs-validation" novalidate >
        <div class = "mb-3">
        <label for =" username" class = "form-label"> Enter the registered username</label>  
    <input 
    name = "username"
    id = "username"
    placeholder = "Enter a valid username" 
    class = "form-control"  
    type = "text"
    required>
   
  
</div>
<div class = "mb-3">
        <label for =" password" class = "form-label">Password </label>  
    <input 
    name = "password"
    id = "password"
    
    class = "form-control"  
    type = "password"
    required>
   
   <br>
</div>
  <button class = "btn btn-success">Login</button>
</div>
</div>
</form>